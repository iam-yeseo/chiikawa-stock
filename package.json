{
  "name": "chiikawa-stocks",
  "productName": "먼작주",
  "version": "0.5.1",
  "description": "먼작주 — 토스증권 시세를 알려주는 데스크톱 캐릭터",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "author": "Chiikawa Stocks",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "dist:mac": "npm run build && electron-builder --mac zip --arm64 --x64",
    "dist:win": "npm run build && electron-builder --win nsis zip --x64",
    "dist:dir": "npm run build && electron-builder --dir",
    "test:roaming": "node scripts/smoke-roaming.mjs",
    "test:portfolio": "node scripts/smoke-portfolio.mjs",
    "test:characters": "node scripts/smoke-characters.mjs",
    "test:companion": "node scripts/smoke-companion.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1",
    "vite": "6.4.4"
  },
  "build": {
    "appId": "im.chii.stocks",
    "productName": "Meonjakju",
    "asar": true,
    "directories": {
      "output": "release/0.5.1"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "lib/**/*",
      "assets/fonts/NOTICE.md",
      "package.json"
    ],
    "artifactName": "Meonjakju-${version}-${os}-${arch}.${ext}",
    "mac": {
      "icon": "assets/character/app-icon.png",
      "category": "public.app-category.finance",
      "target": [
        "zip"
      ],
      "hardenedRuntime": true,
      "identity": null,
      "extendInfo": {
        "CFBundleDisplayName": "먼작주"
      }
    },
    "win": {
      "icon": "assets/character/app-icon.png",
      "target": [
        "nsis",
        "zip"
      ],
      "signExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "먼작주"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "iam-yeseo",
        "repo": "chiikawa-stock",
        "releaseType": "release"
      }
    ],
    "electronUpdaterCompatibility": ">=2.16",
    "executableName": "Meonjakju"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iam-yeseo/chiikawa-stock.git"
  }
}
